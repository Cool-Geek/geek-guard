<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared building blocks for the bot and its plugins: database access, migrations and core data. -->
  <PropertyGroup>
    <RootNamespace>GeekGuard.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Dapper" Version="2.1.89" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQL migrations ship inside the assembly, so a deployment is just the published folder. -->
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>

</Project>
